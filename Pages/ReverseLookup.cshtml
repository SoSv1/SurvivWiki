@page
@model SurviveWiki.Pages.ReverseLookupModel
@{
    ViewData["Title"] = "What can I craft?";
    ViewData["Wide"] = true;
}

<div class="lookup" data-lookup>
    <aside class="lookup-pack" aria-labelledby="pack-heading">
        <h2 id="pack-heading" class="lookup-pack-title">Your items</h2>
        <p class="lookup-pack-hint">Tap everything you are carrying.</p>

        @* A filter for this list only. It is styled unlike the wiki search in the nav bar so the two are not confused. *@
        <div class="lookup-filter-box">
            <label for="pack-filter">Narrow this list</label>
            <input id="pack-filter" class="lookup-filter" type="text" placeholder="type a name, e.g. rope"
                   autocomplete="off" data-lookup-filter />
        </div>
        <p class="lookup-filter-empty" data-lookup-filter-empty hidden>
            No item in this list has that name. To look up any item, use “Search the whole wiki” at the top.
        </p>

        @foreach (var group in Model.Groups)
        {
            <details class="lookup-group" open="@group.Open" data-lookup-group>
                <summary>
                    <span>@group.Title</span>
                    <span class="lookup-group-count">@group.Materials.Count</span>
                </summary>
                <div class="lookup-chips">
                    @foreach (var material in group.Materials)
                    {
                        <button type="button" class="lookup-chip" aria-pressed="false"
                                data-lookup-item="@material.Name" data-icon="@material.IconUrl">
                            <partial name="_ItemIcon" model="new ItemIconModel(material.Name, 28)" />
                            <span>@material.Name</span>
                        </button>
                    }
                </div>
            </details>
        }
    </aside>

    <section class="lookup-results" aria-labelledby="lookup-heading">
        <header class="lookup-header">
            <h1 id="lookup-heading">What can I craft?</h1>
            <p class="lookup-status" aria-live="polite" data-lookup-status>Pick your items on the left to see what you can make.</p>
        </header>

        <div class="lookup-selected" data-lookup-selected hidden>
            <span class="lookup-selected-label">IN YOUR PACK</span>
            <div class="lookup-selected-chips" data-lookup-selected-chips></div>
            <button type="button" class="lookup-clear" data-lookup-clear>Clear all</button>
        </div>

        <div class="lookup-empty" data-lookup-empty>
            <p class="lookup-empty-title">How this page works</p>
            <ol class="lookup-how">
                <li>
                    <span class="lookup-how-art">
                        <partial name="_ItemIcon" model='new ItemIconModel("Twigs", 56)' />
                        <partial name="_ItemIcon" model='new ItemIconModel("Flint", 56)' />
                    </span>
                    <span class="lookup-how-number">1</span>
                    <strong>Tap what you carry</strong>
                    <span class="lookup-how-text">Pick your items in the list on the left.</span>
                </li>
                <li>
                    <span class="lookup-how-art">
                        <partial name="_ItemIcon" model='new ItemIconModel("Axe", 72)' />
                    </span>
                    <span class="lookup-how-number">2</span>
                    <strong>See what you can make</strong>
                    <span class="lookup-how-text">Recipes show up here right away.</span>
                </li>
                <li>
                    <span class="lookup-how-art lookup-how-art-missing">
                        <partial name="_ItemIcon" model='new ItemIconModel("Rope", 56)' />
                        <span class="lookup-how-plus" aria-hidden="true">?</span>
                    </span>
                    <span class="lookup-how-number">3</span>
                    <strong>Spot what is missing</strong>
                    <span class="lookup-how-text">You also see recipes that are one item short.</span>
                </li>
            </ol>
            <p class="lookup-how-try">Just started a new world?</p>
            <button type="button" class="btn btn-primary" data-lookup-starter="Twigs|Cut Grass|Flint">
                Try it: I have Twigs, Cut Grass and Flint
            </button>
        </div>

        <div data-lookup-ready hidden>
            <h2 class="lookup-section-title">
                You can craft now <span class="lookup-section-count" data-lookup-ready-count>0</span>
            </h2>
            <p class="lookup-section-note">You have every ingredient. Check that you have enough of each.</p>
            <div class="lookup-cards" data-lookup-ready-cards></div>
        </div>

        <div data-lookup-almost hidden>
            <h2 class="lookup-section-title">
                One item short <span class="lookup-section-count" data-lookup-almost-count>0</span>
            </h2>
            <p class="lookup-section-note">Find the missing ingredient and these open up too.</p>
            <div class="lookup-cards" data-lookup-almost-cards></div>
        </div>

        <noscript>
            <p class="alert alert-warning">This tool needs JavaScript. You can still <a asp-page="/Search">search for an item</a>.</p>
        </noscript>
    </section>
</div>

<script type="application/json" id="lookup-recipes">@Html.Raw(Model.RecipesJson)</script>

@section Scripts {
    <script src="~/js/reverse-lookup.js" asp-append-version="true"></script>
}
