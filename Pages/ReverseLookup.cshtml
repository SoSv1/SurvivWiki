@page
@model SurviveWiki.Pages.ReverseLookupModel
@{
    ViewData["Title"] = "What can I craft?";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>What's in your inventory?</h2>
            <p class="text-muted">Select the items you have, and we'll tell you what you can make.</p>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Inventory Checkboxes -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Your Items</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="accordion" id="inventoryCategories">
                        @{
                            var categoryIndex = 0;
                            var materialGroups = Model.AvailableMaterials
                                .GroupBy(material => material.Category)
                                .ToList();
                            var categories = materialGroups
                                .Where(group => group.Count() > 1)
                                .Select(group => new { Name = group.Key, Materials = group.ToList() })
                                .OrderBy(group => group.Name)
                                .ToList();
                            var singleItems = materialGroups
                                .Where(group => group.Count() == 1)
                                .SelectMany(group => group)
                                .OrderBy(material => material.Name)
                                .ToList();
                            if (singleItems.Any())
                            {
                                categories.Add(new { Name = "Other", Materials = singleItems });
                            }
                        }
                        @foreach (var category in categories)
                        {
                            var collapseId = $"inventory-category-{categoryIndex}";
                            var hasSelectedItems = category.Materials.Any(item => Model.SelectedItemIds.Contains(item.Id));
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(hasSelectedItems ? "" : "collapsed")" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                            aria-expanded="@(hasSelectedItems ? "true" : "false")" aria-controls="@collapseId">
                                        @category.Name <span class="badge text-bg-secondary ms-2">@category.Materials.Count</span>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(hasSelectedItems ? "show" : "")"
                                     data-bs-parent="#inventoryCategories">
                                    <div class="accordion-body">
                                    @foreach (var material in category.Materials)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedItemIds"
                                                   value="@material.Id"
                                                   id="item_@material.Id"
                                                   @(Model.SelectedItemIds.Contains(material.Id) ? "checked" : "")>
                                            <label class="form-check-label user-select-none item-with-icon" for="item_@material.Id">
                                                <partial name="_ItemIcon" model="new ItemIconModel(material.Name, 28)" />
                                                @material.Name
                                            </label>
                                        </div>
                                    }
                                    </div>
                                </div>
                            </div>
                            categoryIndex++;
                        }
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-3">Find Recipes</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Results -->
        <div class="col-md-8">
            @if (Model.HasSearched)
            {
                <h4 class="mb-3">You can craft:</h4>
                
                @if (Model.CraftableItems.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var item in Model.CraftableItems)
                        {
                            <div class="col">
                                <div class="card h-100 border-success shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title text-success">
                                            <a asp-page="/Item" asp-route-name="@item.Name" class="item-with-icon text-decoration-none text-success">
                                                <partial name="_ItemIcon" model="new ItemIconModel(item.Name, 40)" />
                                                @item.Name
                                            </a>
                                        </h5>
                                        <p class="card-text small">@item.Description</p>
                                        
                                        <hr />
                                        <p class="mb-1 fw-bold small text-muted">Requires:</p>
                                        <ul class="list-unstyled small mb-0">
                                            @foreach (var ingredient in item.CraftedFrom)
                                            {
                                                <li class="item-with-icon d-flex mb-1">
                                                    <partial name="_ItemIcon" model="new ItemIconModel(ingredient.IngredientItem.Name, 24)" />
                                                    @ingredient.IngredientItem.Name (x @ingredient.QuantityRequired)
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        You don't have enough materials to craft anything yet. Try gathering more items!
                    </div>
                }
            }
        </div>
    </div>
</div>