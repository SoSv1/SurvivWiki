@page
@model SurviveWiki.Pages.ReverseLookupModel
@{
    ViewData["Title"] = "What can I craft?";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>What's in your inventory?</h2>
            <p class="text-muted">Select the items you have, and we'll tell you what you can make.</p>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Inventory Checkboxes -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Your Items</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        @foreach (var material in Model.AvailableMaterials)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" 
                                       name="SelectedItemIds" 
                                       value="@material.Id" 
                                       id="item_@material.Id"
                                       @(Model.SelectedItemIds.Contains(material.Id) ? "checked" : "")>
                                <label class="form-check-label user-select-none" for="item_@material.Id">
                                    @material.Name
                                </label>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary w-100 mt-3">Find Recipes</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Results -->
        <div class="col-md-8">
            @if (Model.HasSearched)
            {
                <h4 class="mb-3">You can craft:</h4>
                
                @if (Model.CraftableItems.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var item in Model.CraftableItems)
                        {
                            <div class="col">
                                <div class="card h-100 border-success shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title text-success">
                                            <a asp-page="/Item" asp-route-name="@item.Name" class="text-decoration-none text-success">
                                                @item.Name
                                            </a>
                                        </h5>
                                        <p class="card-text small">@item.Description</p>
                                        
                                        <hr />
                                        <p class="mb-1 fw-bold small text-muted">Requires:</p>
                                        <ul class="list-unstyled small mb-0">
                                            @foreach (var ingredient in item.CraftedFrom)
                                            {
                                                <li>- @ingredient.IngredientItem.Name (x @ingredient.QuantityRequired)</li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        You don't have enough materials to craft anything yet. Try gathering more items!
                    </div>
                }
            }
        </div>
    </div>
</div>