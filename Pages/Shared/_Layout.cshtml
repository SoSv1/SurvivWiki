<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SurviveWiki</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/SurviveWiki.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

@{
    // Used to highlight the page the player is on in the nav bar.
    var currentPage = ViewContext.RouteData.Values["page"] as string;
}
<body>
    <header>
        <nav class="wiki-nav navbar navbar-expand-lg navbar-toggleable-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">SurviveWiki</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(currentPage == "/Index" ? "is-active" : "")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(currentPage == "/ReverseLookup" ? "is-active" : "")" asp-area="" asp-page="/ReverseLookup">Reverse
                                Lookup</a>
                            </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(currentPage == "/Guide" ? "is-active" : "")" asp-area="" asp-page="/Guide">First 5 Days</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(currentPage == "/Contribute" ? "is-active" : "")" asp-area="" asp-page="/Contribute">Add a page</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(currentPage == "/Review" ? "is-active" : "")" asp-area="" asp-page="/Review">Review queue</a>
                        </li>
                        </ul>
                        <!-- You can add more nav links here later -->
                        
                        <!-- NEW: Search Bar Form -->
                        <form class="d-flex" method="get" asp-page="/Search">
                            <!-- The name="query" attribute must match the BindProperty in Search.cshtml.cs -->
                            <input class="form-control me-2" type="search" name="query" placeholder="Search the whole wiki…"
                                   aria-label="Search the whole wiki">
                            <button class="btn btn-outline-primary wiki-nav-go" type="submit" aria-label="Search the whole wiki" title="Search the whole wiki">&#x2315;</button>
                        </form>
            
                    </div>
                </div>
            </nav>
        </header>
        <div class="@(ViewData["Wide"] is true ? "container-fluid wiki-wide" : "container")">
            <main role="main" class="wiki-main pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="wiki-footer border-top footer text-muted">
            <div class="container">
                &copy; 2026 - SurviveWiki - <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
